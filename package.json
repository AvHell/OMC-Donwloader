{
  "name": "omcdownloader",
  "version": "1.0.0",
  "description": "OMC Music Downloader - Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.omcdownloader.app",
    "productName": "OMC Downloader",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": ["**/*"]
      }
    ]
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-store": "^8.1.0",
    "fs-extra": "^11.2.0",
    "music-metadata": "^10.0.0",
    "node-id3": "^0.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  }
}