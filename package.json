{
  "name": "omcdownloader",
  "version": "2.0.0",
  "description": "OMC Music Downloader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --config electron-builder.config.js",
    "dist": "electron-builder --config electron-builder.config.js --win --x64",
    "release": "electron-builder --config electron-builder.config.js --win --x64 --publish always"
  },
  "build": {
    "appId": "com.omcdownloader.app",
    "productName": "OMC Downloader",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": ["**/*"]
      }
    ]
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-store": "^8.1.0",
    "fs-extra": "^11.2.0",
    "music-metadata": "^10.0.0",
    "node-id3": "^0.2.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  }
}